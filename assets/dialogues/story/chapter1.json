    "first": {
      "commands": [
        {
          "speaker": "SYSTEM_COMMAND",
          "text": "STOP_BGM"
        },
        {
          "speaker": "",
          "text": "うわなつかしいな"
        },
        {
          "speaker": "SYSTEM_COMMAND",
          "text": "STOP_BGM"
        },
        {
          "speaker": "",
          "text": "だいぶ荒れてるけど本当に妖怪が出たりしてな"
        },
        {
          "speaker": "SYSTEM_COMMAND",
          "text": "STOP_BGM"
        },
        {
          "speaker": "",
          "text": "ははっ"
        },
        {
          "speaker": "SYSTEM_COMMAND",
          "text": "STOP_BGM"
        },
        {
          "speaker": "",
          "text": "まずどこいく？"
        },
        {
          "speaker": "SYSTEM_COMMAND",
          "text": "STOP_BGM"
        },
        {
          "speaker": "",
          "text": "まずは学校の七不思議といえばの場所3階の女子トイレに行きましょう"
        },
        {
          "speaker": "SYSTEM_COMMAND",
          "text": "STOP_BGM"
        },
        {
          "speaker": "",
          "text": "当時からトイレの花子さんの噂は流行ってたし"
        },
        {
          "speaker": "SYSTEM_COMMAND",
          "text": "STOP_BGM"
        },
        {
          "speaker": "",
          "text": "行こう！"
        },
        {
          "speaker": "SYSTEM_COMMAND",
          "text": "STOP_BGM"
        },
        {
          "speaker": "",
          "text": "今更だけど俺らって女子トイレ入っていいの？"
        },
        {
          "speaker": "SYSTEM_COMMAND",
          "text": "STOP_BGM"
        },
        {
          "speaker": "",
          "text": "マジで今更何を言ってんだよ"
        },
        {
          "speaker": "SYSTEM_COMMAND",
          "text": "STOP_BGM"
        },
        {
          "speaker": "",
          "text": "トイレの花子さんの噂を試す"
        },
        {
          "speaker": "SYSTEM_COMMAND",
          "text": "STOP_BGM"
        },
        {
          "speaker": "",
          "text": "やっぱり何も起きないね"
        },
        {
          "speaker": "SYSTEM_COMMAND",
          "text": "STOP_BGM"
        },
        {
          "speaker": "",
          "text": "そりゃそうだろ"
        },
        {
          "speaker": "SYSTEM_COMMAND",
          "text": "STOP_BGM"
        },
        {
          "speaker": "",
          "text": "でもトイレといえば鏡の噂もあったよね"
        },
        {
          "speaker": "SYSTEM_COMMAND",
          "text": "STOP_BGM"
        },
        {
          "speaker": "",
          "text": "鏡に向かって祈りを捧げると、鏡の向こうに引き込まれるってやつ？"
        },
        {
          "speaker": "SYSTEM_COMMAND",
          "text": "STOP_BGM"
        },
        {
          "speaker": "",
          "text": "そうそう"
        },
        {
          "speaker": "SYSTEM_COMMAND",
          "text": "STOP_BGM"
        },
        {
          "speaker": "",
          "text": "やってみろよ主人公"
        },
        {
          "speaker": "SYSTEM_COMMAND",
          "text": "STOP_BGM"
        },
        {
          "speaker": "",
          "text": "はいはい"
        },
        {
          "speaker": "SYSTEM_COMMAND",
          "text": "STOP_BGM"
        },
        {
          "speaker": "",
          "text": "僕は鏡に向かって祈りを捧げる"
        },
        {
          "speaker": "SYSTEM_COMMAND",
          "text": "STOP_BGM"
        },
        {
          "speaker": "",
          "text": "これでいいのか？"
        },
        {
          "speaker": "SYSTEM_COMMAND",
          "text": "STOP_BGM"
        },
        {
          "speaker": "",
          "text": "その瞬間、空気が変わるのがわかった"
        },
        {
          "speaker": "SYSTEM_COMMAND",
          "text": "STOP_BGM"
        },
        {
          "speaker": "",
          "text": "全員の背筋が凍った"
        },
        {
          "speaker": "SYSTEM_COMMAND",
          "text": "STOP_BGM"
        },
        {
          "speaker": "",
          "text": "それとほぼ同時に後ろの女子トイレのドアが開く音がした"
        },
        {
          "speaker": "SYSTEM_COMMAND",
          "text": "STOP_BGM"
        },
        {
          "speaker": "",
          "text": "その中から小学生くらいの女の子が出てきた"
        },
        {
          "speaker": "SYSTEM_COMMAND",
          "text": "STOP_BGM"
        },
        {
          "speaker": "",
          "text": "あなた達が私を呼んだの？"
        },
        {
          "speaker": "SYSTEM_COMMAND",
          "text": "STOP_BGM"
        },
        {
          "speaker": "",
          "text": "……"
        },
        {
          "speaker": "SYSTEM_COMMAND",
          "text": "STOP_BGM"
        },
        {
          "speaker": "",
          "text": "全員が状況をのみ込めずにいた"
        },
        {
          "speaker": "SYSTEM_COMMAND",
          "text": "STOP_BGM"
        },
        {
          "speaker": "",
          "text": "あなたが花子さん？"
        },
        {
          "speaker": "SYSTEM_COMMAND",
          "text": "STOP_BGM"
        },
        {
          "speaker": "",
          "text": "そうだよお姉ちゃん"
        },
        {
          "speaker": "SYSTEM_COMMAND",
          "text": "STOP_BGM"
        },
        {
          "speaker": "",
          "text": "お姉ちゃん達の体を私にくれない？"
